# OpenAI (required)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1

# CORS — comma-separated. Vite dev is 5173; add your Vercel URL for prod.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Logging
LOG_LEVEL=INFO

# v2 observability options — leave unset in v1 (see plan §7.7).
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
# LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=portfolio-bot
